# SOSO_VALUE_API_KEY / SOSO_API_KEY: Required for SoSoValue data ingestion.
# Get yours at https://sosovalue.xyz/
SOSO_VALUE_API_KEY="MY_SOSO_VALUE_API_KEY"
SOSO_API_KEY="MY_SOSO_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Telegram Sentinel (backend, Task: Global Sentinel bot) ---
# TELEGRAM_TOKEN: Bot token from @BotFather.
# TELEGRAM_CHAT_ID: The auditor's chat ID that receives 7-Day Neural Insight
# push notifications. Both are optional — if either is unset,
# send_telegram_message() silently no-ops rather than failing anything.
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""
