# SOSO_VALUE_API_KEY / SOSO_API_KEY: Required for SoSoValue data ingestion.
# Get yours at https://sosovalue.xyz/
SOSO_VALUE_API_KEY="MY_SOSO_VALUE_API_KEY"
SOSO_API_KEY="MY_SOSO_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Ethereum Sepolia Execution Layer (Task 2 / frontend, Vite-exposed) ---
# VITE_CONTRACT_ADDRESS: the deployed SoSoVaultExecutor address on Ethereum
# Sepolia (Wave 2 production deployment). src/lib/contract.ts already falls
# back to this same address if the env var is unset, so this is optional —
# set it explicitly if you redeploy to a new address.
VITE_CONTRACT_ADDRESS="0x68E4412Ad8645cC45bD170fa4E4A745b0441bfEf"

# VITE_AUTHORIZED_AUDITOR: the official auditor wallet the contract's
# AUTHORIZED_AUDITOR() getter should return. Used only for UI display in the
# Evidence Vault "ON-CHAIN VERIFICATION" panel.
VITE_AUTHORIZED_AUDITOR="0x551B3c796dC89726BDAe006Ce9273dcFf8FB5414"

# VITE_SEPOLIA_RPC_URL: optional dedicated Sepolia RPC (Alchemy/Infura/etc).
# Falls back to the public Sepolia RPC baked into viem if left unset.
VITE_SEPOLIA_RPC_URL=""

# --- Telegram Sentinel (backend, Task: Global Sentinel bot) ---
# TELEGRAM_TOKEN: Bot token from @BotFather.
# TELEGRAM_CHAT_ID: The auditor's chat ID that receives 7-Day Neural Insight
# push notifications. Both are optional — if either is unset,
# send_telegram_message() silently no-ops rather than failing anything.
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""
